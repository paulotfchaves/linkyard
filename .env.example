# Linkyard configuration. Copy to .env and fill in — never commit the result.
#
#     cp .env.example .env
#
# Every value below is a placeholder. Generate the three secrets with:
#
#     openssl rand -hex 32
#
# On Railway none of this file is used: railway-template.json declares the same
# variables and generates the secrets at deploy time, so nobody picks them.

# ─── postgres ────────────────────────────────────────────────────────────────
# Read by the postgres container and used to compose DATABASE_URL for the other
# two services. Docker Compose only.

# Without it the postgres image refuses to initialise.
POSTGRES_USER=linkyard
# Without it the same. Treat it as a secret: it is one third of DATABASE_URL.
# Use `openssl rand -hex 32` — hex needs no percent-encoding in a URL, which a
# password containing @, / or & would.
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-32
# Without it the schema lands in a database named after the user, and the
# migrations still run — so the damage is silent until a restore.
POSTGRES_DB=linkyard

# ─── edge and panel (both read all of these) ─────────────────────────────────
# ENCRYPTION_KEY and IP_HASH_SALT must hold the SAME value in both services. Two
# different values, and the edge cannot open a credential the panel sealed, and
# one visitor counts as two.

# Where the state lives. Without it neither service starts at all.
#
# Leave it unset for a Compose install: docker-compose.yml builds it from the
# three POSTGRES_* values above, so a password lives in exactly one place. Set
# it only to point at a database this file does not manage — a managed provider,
# or a Postgres you already run.
#
# Do NOT append ?sslmode=require unless the server actually speaks TLS. Inside
# Docker Compose and inside Railway's private network Postgres serves plain TCP
# and rejects the handshake, and the resulting crash reads like an outage. A
# managed provider that wants TLS says so, and only then does the parameter
# belong here. `node scripts/doctor.mjs` tells you which side is wrong.
#
# DATABASE_URL=postgres://db.example.com:5432/linkyard?user=linkyard&password=...&sslmode=require

# Master key for the credential vault (AES-256-GCM, core/vault.mjs). Without it
# the panel cannot seal or open the Cloudflare and Railway tokens it stores, so
# domain provisioning stops working. Change it after credentials exist and every
# stored credential becomes unreadable — there is no recovery.
# At least 32 characters.
ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# HMAC salt for click_events.ip_hash. Without it the edge cannot record a click
# without storing a raw IP, which is personal data under the LGPD and the GDPR.
# Change it and unique-visitor counts restart from zero, because the same
# visitor now hashes to a different value.
IP_HASH_SALT=replace-me-with-openssl-rand-hex-32

# The port each service listens on. Compose and Railway both set it per service
# (edge 3100, panel 3000); it appears here because a service that ignores it
# fails its healthcheck on Railway with "service unavailable".
# PORT=3100

# ─── panel only ──────────────────────────────────────────────────────────────

# Guards the first-run setup route. Without it that route answers 404 and the
# first account can never be created. It is not a convenience: the panel's
# certificate is published to Certificate Transparency logs seconds after
# issuance, and scanners read that stream looking for open setup forms. Whoever
# arrives first without this token becomes the owner of your panel, on your
# domain, billed to you. The token stops working once the first user exists.
SETUP_TOKEN=replace-me-with-openssl-rand-hex-32

# Absolute origin used to build invite links. Without it the panel falls back to
# the request's own Host header, which the caller controls — a poisoned one
# produces an invite pointing at a copy of the join form, where the new member
# types the password they were about to use here.
PANEL_ORIGIN=https://panel.example.com

# `vps` or `railway`. Decides how a new subdomain gets its infrastructure host:
# on a VPS the wildcard certificate already covers it and there is nothing to
# create; on Railway a custom domain must be requested and polled. Wrong value,
# and provisioning either does nothing or calls an API that is not there.
INFRA_PROVIDER=vps

# Set to 1 to load the demonstration dataset on first boot. Without it (the
# default) nothing is seeded. It only ever runs against a database with no
# users, so it cannot overwrite a real installation.
# SEED_DEMO=1

# ─── caddy (Docker Compose only) ─────────────────────────────────────────────
# Railway issues its own certificates; none of this section applies there.

# Contact address for the Let's Encrypt account. Without it issuance still
# works, but expiry warnings go nowhere.
ACME_EMAIL=you@example.com

# Cloudflare API token for the DNS-01 challenge — Zone:Read + DNS:Edit on the
# zones you redirect from. Without it Caddy cannot prove control of the zone and
# every certificate fails, so no host serves HTTPS.
#
# This is Caddy's own copy and the only credential that lives in an environment
# variable. The tokens the panel uses are sealed in the database by
# core/vault.mjs; Caddy has no way to read that.
CLOUDFLARE_API_TOKEN=replace-me

# The hostname the panel answers on. Without it Caddy has no site block for the
# panel and the panel is unreachable from outside.
LINKYARD_PANEL_HOST=panel.example.com

# The apex your short links live under. Caddy requests one wildcard certificate
# for it, which is what lets a brand-new subdomain serve HTTPS immediately.
# Without it no redirect host is routed at all.
LINKYARD_REDIRECT_APEX=example.com

# ─── diagnostics ─────────────────────────────────────────────────────────────

# Path scripts/doctor.mjs asks each subdomain for. Defaults to /healthz; set it
# only if your edge answers somewhere else, otherwise the health check reports a
# failure that is really a wrong path.
# LINKYARD_HEALTH_PATH=/healthz

# ─── development only ────────────────────────────────────────────────────────

# Database the test suite creates and drops schemas in. Without it the tests
# fall back to postgres://localhost:5432/linkyard_test. Never point it at an
# installation that holds real data.
# TEST_DATABASE_URL=postgres://localhost:5432/linkyard_test
